From 7ae7ed44a4ccd617b4fcb5695d9dee74d93ee722 Mon Sep 17 00:00:00 2001
From: Philip Withnall <pwithnall@gnome.org>
Date: Thu, 12 Mar 2026 17:04:59 +0000
Subject: [PATCH] gtkapplication-wayland: Add a missing NULL check when
 forgetting a window

It is possible for gtk_native_get_surface() to return NULL while a window is
being destroyed. Guard the Wayland session cleanup accordingly.

Upstream: https://gitlab.gnome.org/GNOME/gtk/-/commit/7ae7ed44a4ccd617b4fcb5695d9dee74d93ee722
Remove once nixpkgs GTK includes this commit (expected after 4.22.4).
---
 gtk/gtkapplication-wayland.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/gtk/gtkapplication-wayland.c b/gtk/gtkapplication-wayland.c
index 2158cf666e6..407d80b15c2 100644
--- a/gtk/gtkapplication-wayland.c
+++ b/gtk/gtkapplication-wayland.c
@@ -232,7 +232,8 @@ gtk_application_impl_wayland_window_forget (GtkApplicationImpl *impl,
   GTK_APPLICATION_IMPL_CLASS (gtk_application_impl_wayland_parent_class)->window_forget (impl, window);
 
   surface = gtk_native_get_surface (GTK_NATIVE (window));
-  gdk_wayland_toplevel_remove_from_session (GDK_TOPLEVEL (surface));
+  if (GDK_IS_WAYLAND_TOPLEVEL (surface))
+    gdk_wayland_toplevel_remove_from_session (GDK_TOPLEVEL (surface));
 }
 
 static guint
-- 
2.51.0

