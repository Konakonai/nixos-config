+fn parse_hex_color(value: &str) -> Option<(u8, u8, u8)> {
+    let hex = value.trim().strip_prefix('#').unwrap_or(value.trim());
+    if hex.len() != 6 || !hex.chars().all(|ch| ch.is_ascii_hexdigit()) {
+        return None;
+    }
+
+    let red = u8::from_str_radix(&hex[0..2], 16).ok()?;
+    let green = u8::from_str_radix(&hex[2..4], 16).ok()?;
+    let blue = u8::from_str_radix(&hex[4..6], 16).ok()?;
+    Some((red, green, blue))
+}
+
+fn color_or_default(value: Option<&str>, fallback: (u8, u8, u8)) -> (u8, u8, u8) {
+    value.and_then(parse_hex_color).unwrap_or(fallback)
+}
+
+fn default_theme_rgb(app: &AppType) -> ThemeRgb {
+    ThemeRgb {
+        accent: accent_rgb(app),
+        ok: DRACULA_GREEN,
+        warn: DRACULA_YELLOW,
+        err: DRACULA_RED,
+        dim: DRACULA_COMMENT,
+        comment: DRACULA_COMMENT,
+        cyan: DRACULA_CYAN,
+        surface: DRACULA_SURFACE,
+    }
+}
+
+fn load_runtime_theme(path: &Path, fallback: ThemeRgb) -> Option<ThemeRgb> {
+    let raw = std::fs::read_to_string(path).ok()?;
+    let config = serde_json::from_str::<RuntimeThemeConfig>(&raw).ok()?;
+
+    Some(ThemeRgb {
+        accent: color_or_default(config.accent.as_deref(), fallback.accent),
+        ok: color_or_default(config.ok.as_deref(), fallback.ok),
+        warn: color_or_default(config.warn.as_deref(), fallback.warn),
+        err: color_or_default(config.err.as_deref(), fallback.err),
+        dim: color_or_default(config.dim.as_deref(), fallback.dim),
+        comment: color_or_default(config.comment.as_deref(), fallback.comment),
+        cyan: color_or_default(config.cyan.as_deref(), fallback.cyan),
+        surface: color_or_default(config.surface.as_deref(), fallback.surface),
+    })
+}
+
+fn theme_rgb(app: &AppType) -> ThemeRgb {
+    let fallback = default_theme_rgb(app);
+
+    std::env::var_os(THEME_FILE_ENV)
+        .and_then(|path| load_runtime_theme(Path::new(&path), fallback))
+        .unwrap_or(fallback)
+}
