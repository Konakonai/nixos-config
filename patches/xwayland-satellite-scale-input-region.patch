+/// Xwayland sends `wl_surface.set_input_region` in buffer pixels. Satellite's
+/// host surface is the viewport destination (logical pixels), and pointer
+/// events are multiplied by `SurfaceScaleFactor` before they go back to
+/// Xwayland. Forwarding the region unchanged makes niri hit-test in the wrong
+/// space — clicks miss the visible window. Scale the rects down to match.
+#[derive(Clone)]
+enum RegionOp {
+    Add {
+        x: i32,
+        y: i32,
+        width: i32,
+        height: i32,
+    },
+    Subtract {
+        x: i32,
+        y: i32,
+        width: i32,
+        height: i32,
+    },
+}
+
+struct HostRegion {
+    client: client::wl_region::WlRegion,
+    ops: Mutex<Vec<RegionOp>>,
+}
+
+fn scale_rect(x: i32, y: i32, width: i32, height: i32, scale: f64) -> (i32, i32, i32, i32) {
+    if scale == 0.0 || (scale - 1.0).abs() < f64::EPSILON {
+        return (x, y, width, height);
+    }
+    let x1 = (x as f64 / scale).floor() as i32;
+    let y1 = (y as f64 / scale).floor() as i32;
+    let x2 = ((x + width) as f64 / scale).ceil() as i32;
+    let y2 = ((y + height) as f64 / scale).ceil() as i32;
+    (x1, y1, (x2 - x1).max(0), (y2 - y1).max(0))
+}
+
+fn apply_scaled_region(
+    compositor: &client::wl_compositor::WlCompositor,
+    qh: &QueueHandle<MyWorld>,
+    surface: &client::wl_surface::WlSurface,
+    ops: &[RegionOp],
+    scale: f64,
+) {
+    let scaled = compositor.create_region(qh, ());
+    for op in ops {
+        match *op {
+            RegionOp::Add {
+                x,
+                y,
+                width,
+                height,
+            } => {
+                let (x, y, w, h) = scale_rect(x, y, width, height, scale);
+                if w > 0 && h > 0 {
+                    scaled.add(x, y, w, h);
+                }
+            }
+            RegionOp::Subtract {
+                x,
+                y,
+                width,
+                height,
+            } => {
+                let (x, y, w, h) = scale_rect(x, y, width, height, scale);
+                if w > 0 && h > 0 {
+                    scaled.subtract(x, y, w, h);
+                }
+            }
+        }
+    }
+    surface.set_input_region(Some(&scaled));
+    scaled.destroy();
+}
+
