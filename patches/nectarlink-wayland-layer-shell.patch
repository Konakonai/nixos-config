+struct IslandLayerState {
+    QString position;
+    bool expanded = false;
+    int width = 0;
+    bool initialized = false;
+};
+
+void syncIslandLayer(QWindow *win, LayerShellQt::Window *ls, IslandLayerState &state, bool force)
+{
+    if (!win || !ls)
+        return;
+
+    const QString pos = win->property("position").toString();
+    const bool expanded = win->property("expanded").toBool();
+    const int winW = std::max(win->width(), 400);
+    if (!force && state.initialized && state.position == pos && state.expanded == expanded && state.width == winW)
+        return;
+
+    state.position = pos;
+    state.expanded = expanded;
+    state.width = winW;
+    state.initialized = true;
+
+    // Align vertically with a top bar (exclusiveZone = -1 lets the island sit in
+    // an empty top-center bar slot without pushing tiled windows down).
+    constexpr int kTopMargin = 7;
+    if (pos == QLatin1String("left")) {
+        ls->setAnchors(LayerShellQt::Window::Anchors(
+            LayerShellQt::Window::AnchorTop | LayerShellQt::Window::AnchorLeft));
+        ls->setMargins(QMargins(10, kTopMargin, 0, 0));
+    } else if (pos == QLatin1String("right")) {
+        ls->setAnchors(LayerShellQt::Window::Anchors(
+            LayerShellQt::Window::AnchorTop | LayerShellQt::Window::AnchorRight));
+        ls->setMargins(QMargins(0, kTopMargin, 10, 0));
+    } else {
+        ls->setAnchors(LayerShellQt::Window::Anchors(LayerShellQt::Window::AnchorTop));
+        ls->setMargins(QMargins(0, kTopMargin, 0, 0));
+    }
+
+    // Restrict Wayland input region to the visible pill + ambient halo so the
+    // transparent lower half of the 400x104 canvas stays click-through when
+    // collapsed.
+    const int pillW = expanded ? 380 : 340;
+    const int pillH = expanded ? 88 : 40;
+    constexpr int kPad = 4;
+    int pillX = (winW - pillW) / 2;
+    if (pos == QLatin1String("left"))
+        pillX = 10;
+    else if (pos == QLatin1String("right"))
+        pillX = std::max(0, winW - 10 - pillW);
+
+    const int rx = std::max(0, pillX - kPad);
+    const int rw = std::min(winW - rx, pillW + kPad * 2);
+    const int rh = pillH + 2 + kPad;
+    win->setMask(QRegion(rx, 0, rw, rh));
+}
+
+// Promotes NectarLink's overlay windows (Island, Shelf, Laser) to native
+// wlr-layer-shell surfaces on Wayland compositors that support it (such as
+// Niri and KWin), keeping MainWindow and MirrorWindow as regular xdg_toplevels.
+void attachLayerShellOverlay(QWindow *win)
+{
+    if (!win || win->property("_nl_ls_attached").toBool())
+        return;
+
+    const QString name = win->objectName();
+    const bool isIsland = name == QLatin1String("nectarIsland");
+    const bool isShelf = name == QLatin1String("nectarShelf");
+    const bool isLaser = name == QLatin1String("nectarLaser");
+    if (!isIsland && !isShelf && !isLaser)
+        return;
+
+    // LayerShellQt::Window must be attached before the QWindow becomes visible;
+    // if a window slipped through already visible, tear down its xdg surface
+    // once and re-show it as a layer surface.
+    const bool wasVisible = win->isVisible();
+    if (wasVisible) {
+        win->hide();
+        win->destroy();
+    }
+
+    auto *ls = LayerShellQt::Window::get(win);
+    ls->setExclusiveZone(-1);
+    ls->setActivateOnShow(false);
+    ls->setWantsToBeOnActiveScreen(true);
+
+    if (isIsland) {
+        ls->setLayer(LayerShellQt::Window::LayerTop);
+        ls->setKeyboardInteractivity(LayerShellQt::Window::KeyboardInteractivityNone);
+        ls->setScope(QStringLiteral("nectarlink-island"));
+        win->setProperty("layerShellActive", true);
+        win->setProperty("_nl_ls_attached", true);
+
+        auto state = std::make_shared<IslandLayerState>();
+        syncIslandLayer(win, ls, *state, true);
+        if (auto *qw = qobject_cast<QQuickWindow *>(win)) {
+            QObject::connect(qw, &QQuickWindow::afterAnimating, qw, [win, ls, state]() {
+                if (win->isVisible())
+                    syncIslandLayer(win, ls, *state, false);
+            });
+        }
+    } else if (isShelf) {
+        ls->setLayer(LayerShellQt::Window::LayerTop);
+        ls->setAnchors(LayerShellQt::Window::Anchors(LayerShellQt::Window::AnchorRight));
+        ls->setMargins(QMargins(0, 0, 12, 0));
+        ls->setKeyboardInteractivity(LayerShellQt::Window::KeyboardInteractivityOnDemand);
+        ls->setScope(QStringLiteral("nectarlink-shelf"));
+        win->setProperty("_nl_ls_attached", true);
+    } else if (isLaser) {
+        ls->setLayer(LayerShellQt::Window::LayerOverlay);
+        ls->setAnchors(LayerShellQt::Window::Anchors(
+            LayerShellQt::Window::AnchorTop | LayerShellQt::Window::AnchorLeft));
+        ls->setKeyboardInteractivity(LayerShellQt::Window::KeyboardInteractivityNone);
+        ls->setScope(QStringLiteral("nectarlink-laser"));
+        win->setProperty("_nl_ls_attached", true);
+        auto syncLaser = [win, ls]() {
+            ls->setMargins(QMargins(std::max(0, win->x()), std::max(0, win->y()), 0, 0));
+        };
+        syncLaser();
+        QObject::connect(win, &QWindow::xChanged, win, syncLaser);
+        QObject::connect(win, &QWindow::yChanged, win, syncLaser);
+    }
+
+    if (wasVisible)
+        win->show();
+}
+
+class WaylandLayerShellFilter final : public QObject {
+public:
+    using QObject::QObject;
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (event->type() == QEvent::Show) {
+            if (auto *win = qobject_cast<QWindow *>(watched)) {
+                if (win->objectName() == QLatin1String("nectarIsland") && win->property("_nl_ls_attached").toBool()) {
+                    IslandLayerState tmp;
+                    syncIslandLayer(win, LayerShellQt::Window::get(win), tmp, true);
+                }
+            }
+        }
+        return QObject::eventFilter(watched, event);
+    }
+};
+} // namespace
+#endif
+#endif
+
+void linux_attach_layer_shell_overlays()
+{
+#ifdef __linux__
+    if (!QGuiApplication::platformName().startsWith(QLatin1String("wayland")))
+        return;
+    for (QWindow *win : QGuiApplication::topLevelWindows())
+        attachLayerShellOverlay(win);
 #endif
+}
 
