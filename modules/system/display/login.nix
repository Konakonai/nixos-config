{
  pkgs,
  inputs,
  lib,
  lilyaTheme,
  hostProfile,
  ...
}:

let
  pci = hostProfile.graphics.nvidia.pci;
  hexByte = value: lib.fixedWidthString 2 "0" (lib.toLower (lib.toHexString value));
  nvidiaPciAddress = "0000:${hexByte pci.bus}:${hexByte pci.device}.${toString pci.function}";
  niriPackage = inputs.niri.packages.${pkgs.stdenv.hostPlatform.system}.niri-unstable;
  niriSession = "${niriPackage}/bin/niri-session";
  niriGpuProbe = pkgs.writeShellScriptBin "niri-gpu-probe" ''
        set -euo pipefail

        niri_config_dir="''${XDG_CONFIG_HOME:-$HOME/.config}/niri"
        mkdir -p "$niri_config_dir"
        gpu_kdl="$niri_config_dir/gpu.kdl"
        tmp_kdl="''${gpu_kdl}.tmp.$$"

        has_nvidia_display=0
        for status_file in /sys/bus/pci/devices/${nvidiaPciAddress}/drm/card*/card*-*/status; do
          if [ -f "$status_file" ] && [ "$(<"$status_file")" = "connected" ]; then
            has_nvidia_display=1
            break
          fi
        done

        if [ "$has_nvidia_display" -eq 1 ]; then
          cat <<'EOF' > "$tmp_kdl"
    // Auto-generated by niri-gpu-probe: external display detected on NVIDIA dGPU
    debug {
        render-drm-device "/dev/dri/by-path/pci-${nvidiaPciAddress}-render"
    }
    EOF
        else
          cat <<'EOF' > "$tmp_kdl"
    // Auto-generated by niri-gpu-probe: internal display only. Rendering with Intel iGPU for power efficiency.
    EOF
        fi

        mv -f "$tmp_kdl" "$gpu_kdl"
  '';

  niriLogin = pkgs.writeShellScriptBin "Niri" ''
    ${lib.getExe niriGpuProbe} || true
    export NIRI_CONFIG="$HOME/.config/niri/config.kdl"
    exec ${niriSession} "$@"
  '';
  # niri-flake registers its own niri.desktop; this session wraps niri-session
  # with the GPU probe, so it replaces that entry instead of sitting beside it.
  niriLoginSession =
    let
      desktopFile = pkgs.writeText "niri.desktop" ''
        [Desktop Entry]
        Name=Niri
        Comment=Scrollable-tiling Wayland compositor
        Exec=${lib.getExe niriLogin}
        TryExec=${lib.getExe niriLogin}
        Type=Application
        DesktopNames=niri
      '';
    in
    pkgs.runCommand "niri-wayland-session" { passthru.providedSessions = [ "niri" ]; } ''
      mkdir -p "$out/share/wayland-sessions"
      ln -s ${desktopFile} "$out/share/wayland-sessions/niri.desktop"
    '';

  # The stock Plasma Wayland session, without the X11 entry the package also ships.
  plasmaWaylandSession =
    pkgs.runCommand "plasma-wayland-session" { passthru.providedSessions = [ "plasma" ]; }
      ''
        mkdir -p "$out/share/wayland-sessions"
        ln -s ${pkgs.kdePackages.plasma-workspace.sessions}/share/wayland-sessions/plasma.desktop \
          "$out/share/wayland-sessions/plasma.desktop"
      '';
in
{
  programs.niri = {
    enable = true;
    package = niriPackage;
  };

  # Noctalia owns the authentication prompt in Niri; two agents cannot
  # register for the same session.
  systemd.user.services.niri-flake-polkit.enable = false;

  services.desktopManager.plasma6.enable = true;

  environment.systemPackages = [ niriGpuProbe ];

  systemd.user.units."niri.service" = {
    overrideStrategy = "asDropin";
    text = ''
      [Service]
      ExecStartPre=${lib.getExe niriGpuProbe}
    '';
  };

  services.greetd.enable = false;

  # pam_kwallet5 starts `ksecretd --pam-login` inside the login session scope,
  # and nothing stops it on logout. Every closed session then lingers as
  # "closing", keeping user@.service alive, so group changes never reach niri
  # even after re-login. Niri uses gnome-keyring for Secret Service; KDE apps
  # still reach ksecretd through D-Bus activation, at the cost of Plasma no
  # longer auto-unlocking the wallet at login.
  security.pam.services.login.kwallet.enable = lib.mkForce false;
  security.pam.services.kde.kwallet.enable = lib.mkForce false;

  services.displayManager = {
    defaultSession = "niri";
    sessionPackages = lib.mkForce [
      niriLoginSession
      plasmaWaylandSession
    ];

    sddm = {
      enable = true;
      enableHidpi = true;
      wayland = {
        enable = true;
        compositor = "kwin";
      };
      settings.Theme = {
        CursorTheme = lilyaTheme.cursorThemeName;
        CursorSize = lilyaTheme.cursorSize;
        Font = lilyaTheme.fonts.sans;
      };
      settings.Users.RememberLastSession = false;
    };
  };
}
