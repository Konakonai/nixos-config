{ pkgs, inputs, lib, lilyaTheme, ... }:

let
  niriPackage = inputs.niri.packages.${pkgs.stdenv.hostPlatform.system}.niri-unstable;
  niriSession = "${niriPackage}/bin/niri-session";
  niriGpuProbe = pkgs.writeShellScriptBin "niri-gpu-probe" ''
    set -euo pipefail

    niri_config_dir="''${XDG_CONFIG_HOME:-$HOME/.config}/niri"
    mkdir -p "$niri_config_dir"
    gpu_kdl="$niri_config_dir/gpu.kdl"
    tmp_kdl="''${gpu_kdl}.tmp.$$"

    has_nvidia_display=0
    for status_file in /sys/bus/pci/devices/0000:01:00.0/drm/card*/card*-*/status; do
      if [ -f "$status_file" ] && [ "$(<"$status_file")" = "connected" ]; then
        has_nvidia_display=1
        break
      fi
    done

    if [ "$has_nvidia_display" -eq 1 ]; then
      cat <<'EOF' > "$tmp_kdl"
// Auto-generated by niri-gpu-probe: external display detected on NVIDIA dGPU
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:01:00.0-render"
}
EOF
    else
      cat <<'EOF' > "$tmp_kdl"
// Auto-generated by niri-gpu-probe: internal display only. Rendering with Intel iGPU for power efficiency.
EOF
    fi

    mv -f "$tmp_kdl" "$gpu_kdl"
  '';

  niriLogin = pkgs.writeShellScriptBin "Niri" ''
    unset GBM_BACKEND __GLX_VENDOR_LIBRARY_NAME

    ${lib.getExe niriGpuProbe} || true
    export NIRI_CONFIG="$HOME/.config/niri/config.kdl"
    exec ${niriSession} "$@"
  '';
  plasmaLogin = pkgs.writeShellScriptBin "Plasma-HDR" ''
    unset GBM_BACKEND __GLX_VENDOR_LIBRARY_NAME
    unset QT_STYLE_OVERRIDE QT_WAYLAND_DECORATION

    export QT_QPA_PLATFORMTHEME=kde

    exec ${lib.getExe' pkgs.kdePackages.plasma-workspace "startplasma-wayland"} "$@"
  '';

  mkWaylandSession =
    {
      id,
      name,
      comment,
      command,
      desktopNames,
    }:
    let
      desktopFile = pkgs.writeText "${id}.desktop" ''
        [Desktop Entry]
        Name=${name}
        Comment=${comment}
        Exec=${command}
        TryExec=${command}
        Type=Application
        DesktopNames=${desktopNames}
      '';
    in
    pkgs.runCommand "${id}-wayland-session"
      {
        passthru.providedSessions = [ id ];
      }
      ''
        mkdir -p "$out/share/wayland-sessions"
        ln -s ${desktopFile} "$out/share/wayland-sessions/${id}.desktop"
      '';

  niriLoginSession = mkWaylandSession {
    id = "niri";
    name = "Niri";
    comment = "Scrollable-tiling Wayland compositor";
    command = lib.getExe niriLogin;
    desktopNames = "niri";
  };
  plasmaLoginSession = mkWaylandSession {
    id = "plasma-hdr";
    name = "Plasma-HDR";
    comment = "KDE Plasma Wayland session with the KDE platform theme";
    command = lib.getExe plasmaLogin;
    desktopNames = "KDE";
  };

in
{
  programs.niri = {
    enable = true;
    package = niriPackage;
  };

  services.desktopManager.plasma6.enable = true;

  environment.systemPackages = [ niriGpuProbe ];

  systemd.user.units."niri.service" = {
    overrideStrategy = "asDropin";
    text = ''
      [Service]
      ExecStartPre=${lib.getExe niriGpuProbe}
      UnsetEnvironment=GBM_BACKEND __GLX_VENDOR_LIBRARY_NAME
    '';
  };

  services.greetd.enable = false;

  services.displayManager = {
    defaultSession = "plasma-hdr";
    sessionPackages = lib.mkForce [
      niriLoginSession
      plasmaLoginSession
    ];

    sddm = {
      enable = true;
      enableHidpi = true;
      wayland = {
        enable = true;
        compositor = "kwin";
      };
      settings.Theme = {
        CursorTheme = lilyaTheme.cursorThemeName;
        CursorSize = lilyaTheme.cursorSize;
        Font = lilyaTheme.fonts.sans;
      };
      settings.Users.RememberLastSession = false;
    };
  };
}
