@@ -62,13 +65,37 @@ impl Keyboard {
         bytes.push(0); // xkbcommon expects a NUL terminator
         let file = write_memfd(&bytes)?;
         kb.keymap(XKB_V1, file.as_fd(), bytes.len() as u32);
+        conn.settle()?;
 
-        Ok(Self { kb, keymap })
+        Ok(Self {
+            kb,
+            keymap,
+            mods: Cell::new(0),
+        })
     }
 
     fn key(&self, evdev_code: u32, pressed: bool) {
         let state = if pressed { KEY_PRESSED } else { KEY_RELEASED };
         self.kb.key(now_ms(), evdev_code, state);
+
+        // wlroots (sway, Hyprland) does not derive modifier state from a
+        // virtual keyboard's key events; the client has to report it, or
+        // `ctrl+c` arrives as a plain `c`. Real-modifier bits follow the
+        // generated keymap's modifier_map (Shift, Control, Mod1, Mod4).
+        let bit = match evdev_code {
+            c if c == self.keymap.shift_code => 1 << 0,
+            c if c == self.keymap.ctrl_code => 1 << 2,
+            c if c == self.keymap.alt_code => 1 << 3,
+            c if c == self.keymap.super_code => 1 << 6,
+            _ => return,
+        };
+        let mods = if pressed {
+            self.mods.get() | bit
+        } else {
+            self.mods.get() & !bit
+        };
+        self.mods.set(mods);
+        self.kb.modifiers(mods, 0, 0, 0);
     }
 }
 
